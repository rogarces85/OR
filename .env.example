# ============================================================
#  Sistema Gestión Pagos Osorno Runners — variables de entorno
#  Copiar este archivo como ".env" y ajustar los valores.
#  El archivo .env NO se versiona (ver .gitignore).
# ============================================================

# --- Aplicación -------------------------------------------------------------
# Nombre visible en el título de la app y en /salud.
APP_NAME="Sistema Gestión Pagos Osorno Runners"
# Etiqueta del entorno, solo informativa (por ejemplo: desarrollo, pruebas,
# produccion). Se muestra en /salud.
ENTORNO=desarrollo

# Clave de firma de la sesión (obligatoria en cualquier entorno real).
# Usa un valor largo y aleatorio; no la compartas ni la subas a Git.
# Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-en-tu-entorno

# --- Base de datos MySQL/MariaDB (XAMPP; P-1 / Q-4) -------------------------
# Host y puerto del servidor MySQL. En XAMPP suele ser localhost:3306.
DB_HOST=localhost
DB_PORT=3306
# Nombre de la base creada para el sistema.
DB_NAME=osorno_runners
# Usuario y contraseña de MySQL. El usuario "root" sin contraseña es válido
# solo para el entorno local de XAMPP; en producción usa un usuario dedicado.
DB_USER=root
DB_PASSWORD=

# --- Sesión (Q-2) -----------------------------------------------------------
# Nombre de la cookie firmada que mantiene la sesión. No se comparte entre
# aplicaciones que usen el mismo dominio.
SESSION_COOKIE=or_sesion
# Duración de la sesión en segundos (valor por defecto: 8 horas = 28800).
SESSION_MAX_AGE=28800

# --- Pruebas (opcional, solo para pytest) -----------------------------------
# La suite usa SQLite en memoria por defecto. Para ejecutarla contra MySQL,
# descomenta y usa una base de pruebas (nunca la base de desarrollo):
# TEST_DATABASE_URL=mysql+pymysql://root:@localhost:3306/osorno_runners_test
